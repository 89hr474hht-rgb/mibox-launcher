<?xml version="1.0" encoding="utf-8"?>
<!-- The update card in the top-right corner of the home screen (UpdatePrompt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/mibox_prompt_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mibox_prompt_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mibox_prompt_logo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/mibox_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/mibox_prompt_kicker"
                    android:textAllCaps="true"
                    android:textColor="#8CFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mibox_prompt_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mibox_prompt_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/mibox_version_chip"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFE6DDFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/mibox_prompt_summary"
            style="@style/MiboxText"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mibox_prompt_update"
                style="@style/MiboxPrimary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mibox_update_now"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/mibox_prompt_later"
                style="@style/MiboxPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/mibox_later" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
