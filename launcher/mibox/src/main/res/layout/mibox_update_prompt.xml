<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mibox_prompt_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mibox_prompt_title"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/mibox_prompt_version"
        style="@style/MiboxText"
        android:layout_marginTop="4dp"
        android:textColor="#FFB9E7C7" />

    <TextView
        android:id="@+id/mibox_prompt_summary"
        style="@style/MiboxText"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mibox_prompt_update"
            style="@style/MiboxButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/mibox_update_now" />

        <TextView
            android:id="@+id/mibox_prompt_later"
            style="@style/MiboxButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/mibox_later" />
    </LinearLayout>
</LinearLayout>
