<?xml version="1.0" encoding="utf-8"?>
<!-- App info, over the home screen: a dimmed backdrop and a panel in the launcher's menu style. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mibox_ai_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:id="@+id/mibox_ai_panel"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/mibox_glass_panel"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mibox_ai_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mibox_ai_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/mibox_ai_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="#73FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:id="@+id/mibox_ai_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mibox_ai_open"
                style="@style/MiboxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:drawablePadding="10dp"
                android:text="@string/mibox_ai_open" />

            <TextView
                android:id="@+id/mibox_ai_more"
                style="@style/MiboxButton"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mibox_ai_more" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
