<?xml version="1.0" encoding="utf-8"?>
<!-- The sleep timer's last minute, over whatever is on screen: a countdown chip at the top, and in the middle the
     question with "Add 30 min" focused. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mibox_sleep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DB000000">

    <LinearLayout
        android:id="@+id/mibox_sleep_chip"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="26dp"
        android:background="@drawable/mibox_sleep_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mibox_ic_timer" />

        <TextView
            android:id="@+id/mibox_sleep_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mibox_sleep_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/mibox_sleep_disc">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/mibox_ic_bedtime" />
        </FrameLayout>

        <TextView
            android:id="@+id/mibox_sleep_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/mibox_sleep_title"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mibox_sleep_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFACB8C1"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mibox_sleep_add"
                style="@style/MiboxPrimary"
                android:text="@string/mibox_sleep_add" />

            <TextView
                android:id="@+id/mibox_sleep_now"
                style="@style/MiboxPill"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:text="@string/mibox_sleep_now" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/mibox_sleep_back"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
