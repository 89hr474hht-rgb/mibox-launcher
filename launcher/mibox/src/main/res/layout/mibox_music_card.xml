<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's music card, above the dock on the right: the cover in the collection's colour with bars dancing
     while it plays, whether it plays, the title and the line of lyrics being sung, the play state, and a thin
     progress line along the bottom. OK opens the player. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/mibox_music_card_bg"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/card_cover"
            android:layout_width="60dp"
            android:layout_height="60dp">

            <com.gathin.tvhome.mibox.EqualizerView
                android:id="@+id/card_eq"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="#8CFFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/card_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textDirection="firstStrongLtr"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/card_state"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/mibox_music_state_bg"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/mibox_ic_play"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/card_track"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/mibox_music_track">

        <View
            android:id="@+id/card_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mibox_music_fill" />
    </FrameLayout>
</LinearLayout>
