<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mibox_updates_title"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/mibox_installed"
            style="@style/MiboxText"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/mibox_status"
            style="@style/MiboxText"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/mibox_permission_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mibox_permission_text"
                style="@style/MiboxText"
                android:textColor="#FFFFC37A" />

            <TextView
                android:id="@+id/mibox_permission_open"
                style="@style/MiboxButton"
                android:layout_marginTop="10dp"
                android:text="@string/mibox_permission_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mibox_available_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mibox_available_title"
                style="@style/MiboxHeading"
                android:textColor="#FFB9E7C7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mibox_install"
                    style="@style/MiboxButton"
                    android:text="@string/mibox_install" />

                <TextView
                    android:id="@+id/mibox_ignore"
                    style="@style/MiboxButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/mibox_ignore" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/mibox_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mibox_progress_text"
                style="@style/MiboxText"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />

            <TextView
                style="@style/MiboxHeading"
                android:text="@string/mibox_notes" />

            <TextView
                android:id="@+id/mibox_notes"
                style="@style/MiboxText"
                android:layout_marginTop="8dp"
                android:background="@drawable/mibox_text_focus_bg"
                android:focusable="true"
                android:lineSpacingExtra="4dp"
                android:padding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mibox_ignored_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/mibox_ignored_text"
                style="@style/MiboxText"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/mibox_unignore"
                style="@style/MiboxButton"
                android:text="@string/mibox_unignore" />
        </LinearLayout>

        <TextView
            android:id="@+id/mibox_check"
            style="@style/MiboxButton"
            android:layout_marginTop="24dp"
            android:text="@string/mibox_check_now" />

        <TextView
            style="@style/MiboxHeading"
            android:text="@string/mibox_history" />

        <TextView
            android:id="@+id/mibox_history"
            style="@style/MiboxText"
            android:layout_marginTop="8dp"
            android:background="@drawable/mibox_text_focus_bg"
            android:focusable="true"
            android:lineSpacingExtra="4dp"
            android:padding="8dp" />
    </LinearLayout>
</ScrollView>
