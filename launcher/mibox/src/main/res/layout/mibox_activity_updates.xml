<?xml version="1.0" encoding="utf-8"?>
<!-- The LaunchOS updates page: on the left the logo with what the updater is doing (UpdateHalo), the state and the
     actions; on the right, cards for what is new, notices and the history. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mibox_page_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mibox_page_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="36dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:id="@+id/mibox_left"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.gathin.tvhome.mibox.UpdateHalo
                android:id="@+id/mibox_halo"
                android:layout_width="220dp"
                android:layout_height="220dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/mibox_updates_title"
                android:src="@drawable/mibox_wordmark" />

            <TextView
                android:id="@+id/mibox_installed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#8CFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/mibox_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mibox_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#8CFFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/mibox_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="260dp"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progressDrawable="@drawable/mibox_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mibox_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mibox_offer_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mibox_install"
                    style="@style/MiboxPrimary"
                    android:text="@string/mibox_install" />

                <TextView
                    android:id="@+id/mibox_ignore"
                    style="@style/MiboxPill"
                    android:layout_marginStart="12dp"
                    android:text="@string/mibox_ignore_short" />
            </LinearLayout>

            <TextView
                android:id="@+id/mibox_check"
                style="@style/MiboxPrimary"
                android:layout_marginTop="22dp"
                android:text="@string/mibox_check_now" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/mibox_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mibox_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/mibox_permission_box"
                    style="@style/MiboxCard"
                    android:background="@drawable/mibox_card_warn_bg"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mibox_permission_text"
                        style="@style/MiboxText"
                        android:textColor="#FFFFD08A" />

                    <TextView
                        android:id="@+id/mibox_permission_open"
                        style="@style/MiboxPill"
                        android:layout_marginTop="14dp"
                        android:text="@string/mibox_permission_open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mibox_available_box"
                    style="@style/MiboxCard"
                    android:visibility="gone">

                    <TextView
                        style="@style/MiboxCardKicker"
                        android:text="@string/mibox_notes" />

                    <TextView
                        android:id="@+id/mibox_available_title"
                        style="@style/MiboxCardTitle" />

                    <TextView
                        android:id="@+id/mibox_notes"
                        style="@style/MiboxText"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mibox_text_focus_bg"
                        android:focusable="true"
                        android:lineSpacingExtra="5dp"
                        android:padding="8dp"
                        android:textColor="#D9FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mibox_ignored_box"
                    style="@style/MiboxCard"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mibox_ignored_text"
                        style="@style/MiboxText"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/mibox_unignore"
                        style="@style/MiboxPill"
                        android:text="@string/mibox_unignore" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mibox_about_box"
                    style="@style/MiboxCard">

                    <TextView
                        style="@style/MiboxCardKicker"
                        android:text="@string/mibox_about_kicker" />

                    <TextView
                        style="@style/MiboxCardTitle"
                        android:text="@string/mibox_about_title" />

                    <TextView
                        style="@style/MiboxText"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mibox_about_text" />
                </LinearLayout>

                <LinearLayout
                    style="@style/MiboxCard">

                    <TextView
                        style="@style/MiboxCardKicker"
                        android:text="@string/mibox_history" />

                    <TextView
                        android:id="@+id/mibox_history"
                        style="@style/MiboxText"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/mibox_text_focus_bg"
                        android:focusable="true"
                        android:lineSpacingExtra="6dp"
                        android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
