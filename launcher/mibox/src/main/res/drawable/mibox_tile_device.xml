<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row icon: a white settings glyph in a coloured rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="32dp" android:height="32dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF8E8E93" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp" android:gravity="center"
        android:drawable="@drawable/mibox_sym_settings" />
</layer-list>
