<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row icon: a white note in a pink rounded square, for the Musique page. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="32dp" android:height="32dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF375F" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:width="18dp" android:height="18dp" android:gravity="center"
        android:drawable="@drawable/mibox_ic_music" />
</layer-list>
