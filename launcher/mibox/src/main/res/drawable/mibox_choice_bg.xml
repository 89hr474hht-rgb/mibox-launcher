<?xml version="1.0" encoding="utf-8"?>
<!-- Same look as the launcher's settings rows (app's settings_choice_bg), plus a disabled state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1F26" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5574A987" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFB9E7C7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF242B34" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
