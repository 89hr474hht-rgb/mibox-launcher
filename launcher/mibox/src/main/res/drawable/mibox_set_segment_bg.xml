<?xml version="1.0" encoding="utf-8"?>
<!-- One choice of a segmented setting: white when focused, else clear; the track and the pill that marks the current
     value are drawn by the bar under it (MiboxSegments). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape><solid android:color="@color/lo_focus" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
</selector>
