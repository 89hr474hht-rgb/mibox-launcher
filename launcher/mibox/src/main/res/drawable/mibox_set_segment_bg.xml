<?xml version="1.0" encoding="utf-8"?>
<!-- One choice of a segmented control: white when focused, outlined when it is the current value. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
