<?xml version="1.0" encoding="utf-8"?>
<!-- The page's main button: LaunchOS's blue-violet when idle, white when focused, dim when it cannot be used. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF4F7BFF" android:endColor="#FF9A5CFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
