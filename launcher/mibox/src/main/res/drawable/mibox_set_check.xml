<?xml version="1.0" encoding="utf-8"?>
<!-- The tick at the end of an on/off row while it is on: the accent, dark on the white focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true" android:drawable="@drawable/mibox_check_on_focus" />
    <item android:state_selected="true" android:drawable="@drawable/mibox_check_on" />
    <item android:drawable="@drawable/mibox_check_none" />
</selector>
