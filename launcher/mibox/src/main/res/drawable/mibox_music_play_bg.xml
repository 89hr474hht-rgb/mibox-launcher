<?xml version="1.0" encoding="utf-8"?>
<!-- The big play button: white, with a ring around it while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="3dp" android:color="#8CFFFFFF" /></shape></item>
            <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
                <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset android:inset="6dp">
            <shape android:shape="oval"><solid android:color="#E6FFFFFF" /></shape>
        </inset>
    </item>
</selector>
