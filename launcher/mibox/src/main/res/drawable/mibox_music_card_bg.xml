<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's music card: dark glass, white edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape><solid android:color="#E61A1D26" /><stroke android:width="2dp" android:color="#FFF2F4F8" /><corners android:radius="20dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#B3101219" /><stroke android:width="1dp" android:color="#1FFFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
</selector>
