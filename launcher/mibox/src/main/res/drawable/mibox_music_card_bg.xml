<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's music card: dark glass with a fine edge, a white edge while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape><solid android:color="#F0202026" /><stroke android:width="2dp" android:color="#F2FFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#C70C0C10" /><stroke android:width="1dp" android:color="#2EFFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
</selector>
