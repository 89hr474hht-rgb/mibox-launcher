<?xml version="1.0" encoding="utf-8"?>
<!-- A settings category: white when focused, a faint fill while its page is shown on the right. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape><solid android:color="@color/lo_focus" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/lo_surface_2" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
