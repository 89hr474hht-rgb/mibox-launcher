<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MiboxUpdatesTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/lo_black</item>
        <item name="android:colorBackground">@color/lo_black</item>
    </style>

    <!-- App info over the home screen: a see-through window; the activity draws its own backdrop and motion. -->
    <style name="MiboxOverlayTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="MiboxButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/lo_button_height</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/lo_focus_button</item>
        <item name="android:textColor">@color/lo_text_on_focus</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="MiboxText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lo_text_2</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
    </style>

    <style name="MiboxHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textColor">@color/lo_text</item>
        <item name="android:textSize">@dimen/lo_text_heading</item>
    </style>
    <!-- LaunchOS pages: cards, their small title and headline, and the buttons (shared design system). -->
    <style name="MiboxCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/lo_space_5</item>
        <item name="android:background">@drawable/mibox_card_bg</item>
    </style>

    <style name="MiboxCardKicker">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lo_text_2</item>
        <item name="android:textSize">@dimen/lo_text_label</item>
    </style>

    <style name="MiboxCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/lo_text</item>
        <item name="android:textSize">@dimen/lo_text_heading</item>
    </style>

    <style name="MiboxPrimary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/lo_button_height</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:background">@drawable/lo_button_primary</item>
        <item name="android:textColor">@color/lo_text_on_accent</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="MiboxPill" parent="MiboxPrimary">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/lo_focus_chip</item>
        <item name="android:textColor">@color/lo_text_on_focus</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
    </style>

    <!-- The sleep screen's preview: black from the first frame, no transition. -->
    <style name="MiboxDreamTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Window motion of the Mi Box screens, set on each window by MiboxInit (the launcher's own theme has none).
         Android scales or skips them with the system's animation settings. -->
    <style name="LoWindowPage">
        <item name="android:activityOpenEnterAnimation">@anim/lo_page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/lo_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/lo_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/lo_page_exit</item>
    </style>

    <style name="LoWindowSub">
        <item name="android:activityOpenEnterAnimation">@anim/lo_sub_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/lo_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/lo_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/lo_sub_exit</item>
    </style>
</resources>
