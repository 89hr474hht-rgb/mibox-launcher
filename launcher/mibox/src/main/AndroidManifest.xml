<?xml version="1.0" encoding="utf-8"?>
<!-- mibox-launcher fork: merged into the app only in the Mi Box edition (-Pmibox). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- api.github.com and the release asset downloads. Nothing else is contacted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PackageInstaller sessions for the launcher's own updates; Android still asks the user every time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Keeps the 24 h update check scheduled across reboots (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The sleep timer's alarms on time (granted at install up to Android 12; the box runs Android 11, which needs
         nothing). Without it the alarms come within half a minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The Bluetooth pill and its menu only read the adapter state, the paired devices and their connections.
         BLUETOOTH covers that up to Android 11; from Android 12 it needs BLUETOOTH_CONNECT, which is not asked
         for, so the pill then just reads "Bluetooth". -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The network menu reads the connections and whether Wi-Fi is on (the app declares them too). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The music player reads the audio files on the box's storage and USB drives (asked for from the player, by
         Android's own dialog). Only audio: no photos, no documents. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Music keeps playing behind the sleep screen: a foreground service of the media playback kind. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Same as the app's manifest; repeated so the library lints on its own. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application>
        <!-- Starts with the app process: hooks the home screen and schedules the daily check, so the
             upstream launcher code needs no change. -->
        <provider
            android:name=".MiboxInit"
            android:authorities="${applicationId}.mibox.init"
            android:exported="false" />

        <service
            android:name=".UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- LaunchOS's sleep screen for OLED; switched on from Settings → Veille (DreamSettings). -->
        <service
            android:name=".OledDream"
            android:exported="true"
            android:label="@string/mibox_dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The music player (MusicActivity) and the service that keeps it playing behind other screens. -->
        <activity
            android:name=".MusicActivity"
            android:exported="false"
            android:theme="@style/MiboxUpdatesTheme"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Settings → Veille → Aperçu. -->
        <activity
            android:name=".DreamPreviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/MiboxDreamTheme" />

        <!-- The updates page, listed in the app library so it can be opened from the remote. -->
        <activity
            android:name=".UpdatesActivity"
            android:exported="true"
            android:label="@string/mibox_updates_title"
            android:theme="@style/MiboxUpdatesTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App info from a tile's menu: the upstream launcher opens it through SystemSettings.appInfo. -->
        <activity
            android:name=".AppInfoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/MiboxOverlayTheme">
            <intent-filter>
                <action android:name="com.gathin.tvhome.action.APP_INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The remote's Netflix, YouTube and Prime Video buttons, and the page that chooses what they open. -->
        <activity
            android:name=".RemoteKeysActivity"
            android:exported="false"
            android:theme="@style/MiboxUpdatesTheme" />

        <service
            android:name=".RemoteKeysService"
            android:exported="true"
            android:label="@string/mibox_rk_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mibox_remote_keys_service" />
        </service>

        <!-- The sleep timer: its alarms, and its last minute shown over whatever app is in front. -->
        <receiver
            android:name=".SleepAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".SleepWarningActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.gathin.tvhome.sleep"
            android:theme="@style/MiboxOverlayTheme" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
