<?xml version="1.0" encoding="utf-8"?>
<!-- mibox-launcher fork: LaunchOS's text face, Inter (SIL Open Font License 1.1, mibox/fonts/OFL-Inter.txt), at
     weight 600. Built once per process, like upstream's outfit_* families. -->
