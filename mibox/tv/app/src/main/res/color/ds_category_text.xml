<?xml version="1.0" encoding="utf-8"?>
<!-- A category of the settings list: white when focused or open, dim otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ds_text" android:state_focused="true" />
    <item android:color="@color/ds_text" android:state_selected="true" />
    <item android:color="@color/ds_text_dim" />
</selector>
