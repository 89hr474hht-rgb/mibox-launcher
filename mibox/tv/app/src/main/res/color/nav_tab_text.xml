<?xml version="1.0" encoding="utf-8"?>
<!-- A top-bar item's text: dark on the white focus, white on the section shown, a little dimmer otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/lo_on_focus" android:state_focused="true" />
    <item android:color="@color/lo_text" android:state_activated="true" />
    <item android:color="#D9F4F3F0" />
</selector>
