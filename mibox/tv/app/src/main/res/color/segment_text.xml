<?xml version="1.0" encoding="utf-8"?>
<!-- A SegmentBar value's text: dark on the white focus, white when chosen, dimmer otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/lo_on_focus" android:state_focused="true" />
    <item android:color="@color/lo_text" android:state_selected="true" />
    <item android:color="@color/lo_text_2" />
</selector>
