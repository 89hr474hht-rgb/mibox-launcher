<?xml version="1.0" encoding="utf-8"?>
<!-- The square behind a row's icon: tinted on a dark row, a light grey on a focused (white) row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1A0B0D12" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#264F7BFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
