<?xml version="1.0" encoding="utf-8"?>
<!-- A round player control: glass, white with the accent ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FFF2F4F8" />
            <stroke android:width="2dp" android:color="@color/ds_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="@color/ds_stroke_strong" />
        </shape>
    </item>
</selector>
