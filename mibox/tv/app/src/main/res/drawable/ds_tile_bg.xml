<?xml version="1.0" encoding="utf-8"?>
<!-- A gauge button: glass, with the accent border when focused. Its outline also cuts the gauge's fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/ds_glass_focus" />
            <stroke android:width="2dp" android:color="@color/ds_accent" />
            <corners android:radius="@dimen/ds_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="@color/ds_stroke" />
            <corners android:radius="@dimen/ds_radius" />
        </shape>
    </item>
</selector>
