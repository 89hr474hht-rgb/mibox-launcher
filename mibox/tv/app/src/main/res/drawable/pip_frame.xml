<?xml version="1.0" encoding="utf-8"?>
<!-- The small player's corners (cut by pip_corners) and its outline: white when focused, like a picture tile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/pip_corners" />
            <item>
                <shape><stroke android:width="3dp" android:color="@color/lo_focus" /><corners android:radius="14dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:drawable="@drawable/pip_corners" />
            <item>
                <shape><stroke android:width="1dp" android:color="@color/lo_line_strong" /><corners android:radius="14dp" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
