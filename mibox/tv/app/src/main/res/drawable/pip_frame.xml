<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/pip_corners" />
            <item>
                <shape>
                    <stroke android:width="3dp" android:color="#FFF2F4F8" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:drawable="@drawable/pip_corners" />
            <item>
                <shape>
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
