<?xml version="1.0" encoding="utf-8"?>
<!-- An on/off switch drawn from the row's state: activated is on (the accent), off is a dark track. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape><solid android:color="@color/lo_accent" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="3dp" android:width="20dp" android:height="20dp">
                <shape android:shape="oval"><solid android:color="@color/lo_text" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape><solid android:color="@color/lo_surface_3" /><stroke android:width="1dp" android:color="@color/lo_line_strong" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
            </item>
            <item android:gravity="start|center_vertical" android:left="3dp" android:width="20dp" android:height="20dp">
                <shape android:shape="oval"><solid android:color="@color/lo_text_2" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
