<?xml version="1.0" encoding="utf-8"?>
<!-- An on/off switch drawn from the row's state: activated is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/accent" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="3dp" android:width="20dp" android:height="20dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#FF3A4152" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:gravity="start|center_vertical" android:left="3dp" android:width="20dp" android:height="20dp">
                <shape android:shape="oval">
                    <solid android:color="#FFAEB5C2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
