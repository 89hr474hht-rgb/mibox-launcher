<?xml version="1.0" encoding="utf-8"?>
<!-- A text field on glass: the accent border when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#26FFFFFF" />
            <stroke android:width="2dp" android:color="@color/ds_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/ds_stroke_strong" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
