<?xml version="1.0" encoding="utf-8"?>
<!-- A header that stays at the top while the grid scrolls under it: black, with a hairline underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/lo_black" /></shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape><solid android:color="@color/lo_line" /></shape>
    </item>
</layer-list>
