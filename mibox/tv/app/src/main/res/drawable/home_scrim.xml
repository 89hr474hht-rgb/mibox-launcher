<?xml version="1.0" encoding="utf-8"?>
<!-- Over the hero's picture: dark at the left for the text, and fading fully to black from the middle down. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><gradient android:angle="0" android:startColor="#F0000000" android:centerColor="#80000000" android:endColor="#1A000000" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="90" android:startColor="#FF000000" android:centerY="0.55" android:centerColor="#F2000000" android:endColor="#00000000" /></shape>
    </item>
</layer-list>
