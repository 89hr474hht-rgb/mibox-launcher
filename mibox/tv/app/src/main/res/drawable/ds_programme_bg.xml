<?xml version="1.0" encoding="utf-8"?>
<!-- A programme in the guide: glass; the one on now is a little lighter; the focused one has the accent border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#334F7BFF" />
            <stroke android:width="2dp" android:color="@color/ds_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/ds_stroke_strong" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="@color/ds_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
