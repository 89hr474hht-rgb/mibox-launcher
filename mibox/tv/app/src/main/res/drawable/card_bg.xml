<?xml version="1.0" encoding="utf-8"?>
<!-- A row in Réglages, Actualiser and the like. Focused, it turns white like the menu and the buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFF2F4F8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF161A23" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
