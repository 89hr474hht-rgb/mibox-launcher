<?xml version="1.0" encoding="utf-8"?>
<!-- Over a blurred poster: dark everywhere, darker at the left (the text) and at the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#990A0A0A" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#E60A0A0A" android:centerColor="#660A0A0A"
                android:endColor="#000A0A0A" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#FF0A0A0A" android:centerColor="#000A0A0A"
                android:endColor="#000A0A0A" />
        </shape>
    </item>
</layer-list>
