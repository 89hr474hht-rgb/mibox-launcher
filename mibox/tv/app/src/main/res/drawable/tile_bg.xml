<?xml version="1.0" encoding="utf-8"?>
<!-- A large tile that acts (the refresh gauges): the first surface, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape><solid android:color="@color/lo_focus" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/lo_surface_1" /><stroke android:width="1dp" android:color="@color/lo_line" /><corners android:radius="@dimen/lo_radius_row" /></shape>
    </item>
</selector>
