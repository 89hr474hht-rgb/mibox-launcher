<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:background="@drawable/page_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="196dp"
        android:layout_height="match_parent"
        android:background="#99080A0F"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            tools:ignore="UseCompoundDrawables"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nav_live"
            style="@style/NavItem"
            android:drawableStart="@drawable/ic_live"
            android:drawableTint="@color/nav_text"
            android:text="@string/nav_live" />

        <TextView
            android:id="@+id/nav_movies"
            style="@style/NavItem"
            android:drawableStart="@drawable/ic_movie"
            android:drawableTint="@color/nav_text"
            android:text="@string/nav_movies" />

        <TextView
            android:id="@+id/nav_series"
            style="@style/NavItem"
            android:drawableStart="@drawable/ic_series"
            android:drawableTint="@color/nav_text"
            android:text="@string/nav_series" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/nav_updates"
            style="@style/NavItem"
            android:drawableStart="@drawable/ic_update"
            android:drawableTint="@color/nav_text"
            android:text="@string/nav_updates" />

        <TextView
            android:id="@+id/nav_account"
            style="@style/NavItem"
            android:drawableStart="@drawable/ic_account"
            android:drawableTint="@color/nav_text"
            android:text="@string/nav_account" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="232dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/section_title"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/section_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:paddingStart="12dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="26dp"
            android:paddingEnd="26dp"
            android:paddingBottom="30dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textColor="@color/text_dim"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/update_banner"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/banner_bg"
            android:elevation="12dp"
            android:fontFamily="@font/launchos_semibold"
            android:lineSpacingMultiplier="1.2"
            android:padding="16dp"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
