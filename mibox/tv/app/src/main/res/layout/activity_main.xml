<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: the pages (Accueil, TV, Films, Séries), the navigation bar along the top, and the live player
     above them (full screen or the small window at the bottom right). -->
<com.gathin.launchos.tv.Root xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lo_black">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/page_home"
            layout="@layout/page_home"
            android:visibility="gone" />

        <include
            android:id="@+id/page_live"
            layout="@layout/page_live"
            android:visibility="gone" />

        <include
            android:id="@+id/page_movies"
            layout="@layout/page_browse"
            android:visibility="gone" />

        <include
            android:id="@+id/page_series"
            layout="@layout/page_browse"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="@dimen/lo_page_x"
            android:paddingEnd="@dimen/lo_page_x"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_body"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The navigation bar: Réglages on the left, the sections, the app's small logo on the right. It fades out
         while the remote is down in a page's rows and comes back at the top (MainActivity). -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:background="@drawable/topbar_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lo_page_x"
        android:paddingTop="@dimen/lo_space_2"
        android:paddingEnd="@dimen/lo_page_x">

        <FrameLayout
            android:id="@+id/nav_settings"
            style="@style/NavIcon"
            android:contentDescription="@string/nav_settings">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                android:tint="@color/lo_icon_on_focus" />

            <View
                android:id="@+id/nav_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_accent"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/lo_space_2"
            android:layout_marginEnd="@dimen/lo_space_3"
            android:background="@color/lo_line" />

        <FrameLayout
            android:id="@+id/nav_search"
            style="@style/NavIcon"
            android:contentDescription="@string/nav_search">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/lo_icon_on_focus" />
        </FrameLayout>

        <TextView android:id="@+id/nav_home" style="@style/NavTab" android:text="@string/nav_home" />
        <TextView android:id="@+id/nav_live" style="@style/NavTab" android:text="@string/nav_tv" />
        <TextView android:id="@+id/nav_movies" style="@style/NavTab" android:text="@string/nav_movies" />
        <TextView android:id="@+id/nav_series" style="@style/NavTab" android:text="@string/nav_series" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_mark" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/live_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="true"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/live_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:keepScreenOn="true"
            app:show_buffering="always"
            app:use_controller="false" />

        <include layout="@layout/view_live_overlay" />

        <View
            android:id="@+id/live_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pip_frame"
            android:duplicateParentState="true"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/update_banner"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/lo_panel"
        android:fontFamily="@font/launchos_semibold"
        android:lineSpacingMultiplier="1.2"
        android:padding="16dp"
        android:textSize="@dimen/lo_text_body"
        android:visibility="gone" />
</com.gathin.launchos.tv.Root>
