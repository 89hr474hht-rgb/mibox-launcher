<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: the pages (Accueil, Chaînes, Films, Séries), the live player above them (full screen or the small
     window at the bottom right), and the rail on the left: a dark strip of icons that opens over the page only while it has the
     focus, so it never mixes with the page's own columns. -->
<com.gathin.launchos.tv.Root xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/page_home"
            layout="@layout/page_home"
            android:visibility="gone" />

        <include
            android:id="@+id/page_live"
            layout="@layout/page_live"
            android:visibility="gone" />

        <include
            android:id="@+id/page_movies"
            layout="@layout/page_browse"
            android:visibility="gone" />

        <include
            android:id="@+id/page_series"
            layout="@layout/page_browse"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="120dp"
            android:paddingEnd="48dp"
            android:textColor="@color/text_dim"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/rail_shade"
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/rail_bg"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="@dimen/rail_closed"
        android:layout_height="match_parent"
        android:background="@drawable/rail_strip_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="22dp"
        android:paddingEnd="10dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                android:id="@+id/rail_title"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:alpha="0"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            style="@style/RailItem"
            android:contentDescription="@string/nav_search">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/RailItem"
            android:contentDescription="@string/nav_home">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_live"
            style="@style/RailItem"
            android:contentDescription="@string/nav_live">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_guide"
            style="@style/RailItem"
            android:contentDescription="@string/nav_guide">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_movies"
            style="@style/RailItem"
            android:contentDescription="@string/nav_movies">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_series"
            style="@style/RailItem"
            android:contentDescription="@string/nav_series">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/nav_refresh"
            style="@style/RailItem"
            android:contentDescription="@string/nav_refresh">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            style="@style/RailItem"
            android:contentDescription="@string/nav_settings">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_updates"
            style="@style/RailItem"
            android:contentDescription="@string/nav_updates">

            <include layout="@layout/rail_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_account"
            style="@style/RailItem"
            android:contentDescription="@string/nav_account">

            <include layout="@layout/rail_item" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/live_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="true"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/live_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:keepScreenOn="true"
            app:show_buffering="always"
            app:use_controller="false" />

        <include layout="@layout/view_live_overlay" />

        <View
            android:id="@+id/live_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pip_frame"
            android:duplicateParentState="true"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/update_banner"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/banner_bg"
        android:elevation="12dp"
        android:fontFamily="@font/launchos_semibold"
        android:lineSpacingMultiplier="1.2"
        android:padding="16dp"
        android:textSize="15sp"
        android:visibility="gone" />
</com.gathin.launchos.tv.Root>
