<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/lo_focus_row"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/lo_set_icon"
        android:layout_height="@dimen/lo_set_icon"
        android:layout_marginEnd="@dimen/lo_set_gap"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/lo_icon_on_focus" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="@font/launchos_semibold"
            android:singleLine="true"
            android:textColor="@color/lo_text_on_focus"
            android:textSize="@dimen/lo_set_text_body" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/lo_text_2_on_focus"
            android:textSize="@dimen/lo_set_text_small" />
    </LinearLayout>

    <TextView
        android:id="@+id/pinned"
        style="@style/Tag"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:text="@string/group_pinned"
        android:textColor="@color/lo_text_2_on_focus"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hidden"
        style="@style/Tag"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:text="@string/group_hidden"
        android:textColor="@color/lo_text_2_on_focus"
        android:visibility="gone" />
</LinearLayout>
