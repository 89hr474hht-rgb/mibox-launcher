<?xml version="1.0" encoding="utf-8"?>
<!--
  Guide TV: a timeline. The groups as pills and the focused programme's details at the top; then the hours along
  the top, the channels down the left and their programmes in between, with a line at the current time.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lo_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/lo_page_x"
        android:paddingTop="@dimen/lo_page_y"
        android:paddingEnd="@dimen/lo_page_x">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/launchos_bold"
                android:text="@string/nav_guide"
                android:textSize="@dimen/lo_text_title" />

            <TextView
                android:id="@+id/guide_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="@font/launchos_semibold"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_heading" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/guide_groups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lo_panel"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/guide_detail_title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/lo_text_body" />

            <TextView
                android:id="@+id/guide_detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_body" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/guide_axis"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/guide_channel_width" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/guide_rows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />
            </LinearLayout>

            <View
                android:id="@+id/guide_now"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@color/lo_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/guide_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/lo_text_2"
                    android:textSize="@dimen/lo_text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/retry"
                    style="@style/Button"
                    android:layout_marginTop="@dimen/lo_space_4"
                    android:drawableStart="@drawable/ic_refresh"
                    android:text="@string/retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
