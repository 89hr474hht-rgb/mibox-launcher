<?xml version="1.0" encoding="utf-8"?>
<!-- A row of Réglages and the screens it opens: icon, title, one line under it, and its state, a switch or an arrow.
     Nothing until focused, then white with dark text (lo_focus_row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/lo_focus_row"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/lo_set_row"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/lo_set_icon"
        android:layout_height="@dimen/lo_set_icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/lo_icon_on_focus" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lo_set_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/launchos_semibold"
            android:textColor="@color/lo_text_on_focus"
            android:textSize="@dimen/lo_set_text_body" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:duplicateParentState="true"
            android:textColor="@color/lo_text_2_on_focus"
            android:textSize="@dimen/lo_set_text_small" />
    </LinearLayout>

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lo_set_gap"
        android:duplicateParentState="true"
        android:fontFamily="@font/launchos_medium"
        android:gravity="end"
        android:maxWidth="200dp"
        android:textColor="@color/lo_text_2_on_focus"
        android:textSize="@dimen/lo_set_text_small" />

    <com.gathin.launchos.tv.ToggleView
        android:id="@+id/toggle"
        android:layout_width="36dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:tint="@color/lo_text_2_on_focus"
        android:visibility="gone" />
</LinearLayout>
