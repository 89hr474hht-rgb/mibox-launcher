<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:show_buffering="always"
        app:use_controller="false" />

    <!-- The on-screen display: title and time at the top; a thin seek bar, the controls in the middle and audio,
         subtitles and picture-in-picture at the far right at the bottom. It hides after 3 s without a key. -->
    <FrameLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/ds_osd_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_gravity="bottom"
            android:background="@drawable/ds_osd_bottom" />

        <LinearLayout
            android:id="@+id/osd_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="30dp"
            android:paddingEnd="48dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/osd_title"
                    style="@style/Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/launchos_bold"
                    android:singleLine="true"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/osd_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:textColor="@color/ds_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/osd_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/launchos_semibold"
                android:textColor="@color/ds_text"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/osd_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/osd_position"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/launchos_medium"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/osd_seek"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/osd_seek"
                    android:focusable="true">

                    <View
                        android:id="@+id/osd_track"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/track_bg" />

                    <View
                        android:id="@+id/osd_buffered"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ds_osd_buffered" />

                    <View
                        android:id="@+id/osd_fill"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ds_osd_fill" />

                    <View
                        android:id="@+id/osd_thumb"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ds_osd_thumb" />
                </FrameLayout>

                <TextView
                    android:id="@+id/osd_duration"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/launchos_medium"
                    android:gravity="end"
                    android:textColor="@color/ds_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/osd_back"
                        style="@style/DsOsdButton"
                        android:contentDescription="@string/osd_back"
                        android:src="@drawable/ic_replay10" />

                    <ImageView
                        android:id="@+id/osd_play"
                        style="@style/DsOsdButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:contentDescription="@string/osd_pause"
                        android:padding="18dp"
                        android:src="@drawable/ic_pause" />

                    <ImageView
                        android:id="@+id/osd_forward"
                        style="@style/DsOsdButton"
                        android:contentDescription="@string/osd_forward"
                        android:src="@drawable/ic_forward30" />

                    <ImageView
                        android:id="@+id/osd_next"
                        style="@style/DsOsdButton"
                        android:layout_marginStart="18dp"
                        android:contentDescription="@string/osd_next"
                        android:src="@drawable/ic_next"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/osd_audio"
                        style="@style/DsOsdButton"
                        android:contentDescription="@string/osd_audio"
                        android:src="@drawable/ic_audio" />

                    <ImageView
                        android:id="@+id/osd_subs"
                        style="@style/DsOsdButton"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/osd_subs"
                        android:src="@drawable/ic_subtitles" />

                    <ImageView
                        android:id="@+id/osd_pip"
                        style="@style/DsOsdButton"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/osd_pip"
                        android:src="@drawable/ic_mini" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/sheet_bg"
        android:fontFamily="@font/launchos_semibold"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sheet_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_failed"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry_hint"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
