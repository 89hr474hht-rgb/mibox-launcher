<?xml version="1.0" encoding="utf-8"?>
<!-- Films or Séries, on a charcoal page: the spotlight is a rounded card set in from the edges, its picture fading
     from one title to the next behind the text (the newest titles with Regarder and Plus d'infos, or the focused
     title), a small badge in its lower corner, the search and the whole list in its upper corner; the rows by group
     come underneath and peek in under the card. In the rows the card folds to its text (BrowsePage). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/browse_bg"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/hero_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_card_height"
        android:layout_marginStart="@dimen/page_start"
        android:layout_marginTop="@dimen/hero_card_top"
        android:layout_marginEnd="@dimen/page_start"
        android:background="@drawable/hero_card_bg">

        <ImageView
            android:id="@+id/backdrop_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/backdrop_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_card_scrim" />

        <View
            android:id="@+id/scrim_bottom"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:alpha="0.8"
            android:background="@drawable/hero_card_scrim_bottom" />

        <LinearLayout
            android:id="@+id/spotlight"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="26dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/spot_label"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/logo_mark_small"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/lo_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/spot_title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/launchos_bold"
                android:lineSpacingMultiplier="0.92"
                android:maxLines="2"
                android:textSize="@dimen/hero_title" />

            <TextView
                android:id="@+id/spot_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/launchos_semibold"
                android:singleLine="true"
                android:textColor="@color/lo_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/spot_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:textColor="@color/lo_text"
                android:textSize="@dimen/lo_text_small" />

            <LinearLayout
                android:id="@+id/hero_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_play"
                    style="@style/Button.Glass"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/hero_play" />

                <TextView
                    android:id="@+id/hero_info"
                    style="@style/Button.Glass"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic_info"
                    android:text="@string/hero_info" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hero_dots"
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/action_search"
                style="@style/Chip.Glass"
                android:drawableStart="@drawable/ic_search" />

            <TextView
                android:id="@+id/action_all"
                style="@style/Chip.Glass"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_grid" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_badge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/hero_badge_bg"
            android:drawableStart="@drawable/ic_guide"
            android:drawablePadding="6dp"
            android:drawableTint="@color/lo_accent"
            android:fontFamily="@font/launchos_semibold"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/lo_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="@dimen/rows_height"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="true"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:id="@+id/browse_status_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="140dp"
        android:paddingEnd="60dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/browse_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_body" />

        <TextView
            android:id="@+id/retry"
            style="@style/Button"
            android:layout_marginTop="@dimen/lo_space_4"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
