<?xml version="1.0" encoding="utf-8"?>
<!--
  Connexion: a panel split in two in the middle of the screen, over the posters already on the box, dimmed to 15 %
  and still. Left, the logo and the name; right, the form (server, user name, password with an eye to show it) and
  Se connecter, which turns into a spinner while the server answers. The form is kept out of autofill: the account
  stays on the box only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lo_black">

    <com.gathin.launchos.tv.PosterWall
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.15" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/login_vignette" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="820dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/lo_panel"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/lo_space_6">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/logo_mark" />

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="@font/launchos_bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.9"
                        android:text="@string/login_brand"
                        android:textSize="@dimen/lo_text_display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/login_tagline"
                        android:textColor="@color/lo_text_2"
                        android:textSize="@dimen/lo_text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:importantForAutofill="noExcludeDescendants"
                    android:orientation="vertical"
                    android:padding="@dimen/lo_space_6">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/launchos_bold"
                        android:text="@string/account_title"
                        android:textSize="@dimen/lo_text_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/account_hint"
                        android:textColor="@color/lo_text_2"
                        android:textSize="@dimen/lo_text_small" />

                    <EditText
                        android:id="@+id/server"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:drawableStart="@drawable/ic_server"
                        android:hint="@string/field_server"
                        android:imeOptions="actionNext|flagNoExtractUi"
                        android:inputType="textUri" />

                    <EditText
                        android:id="@+id/user"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:importantForAutofill="no"
                        android:drawableStart="@drawable/ic_account"
                        android:hint="@string/field_user"
                        android:imeOptions="actionNext|flagNoExtractUi"
                        android:inputType="textNoSuggestions|textVisiblePassword" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/password"
                            style="@style/Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAutofill="no"
                            android:drawableStart="@drawable/ic_lock"
                            android:hint="@string/field_password"
                            android:imeOptions="actionDone|flagNoExtractUi"
                            android:inputType="textPassword" />

                        <ImageView
                            android:id="@+id/reveal"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/lo_focus_chip"
                            android:contentDescription="@string/login_show_password"
                            android:focusable="true"
                            android:padding="14dp"
                            android:src="@drawable/ic_eye"
                            android:tint="@color/lo_icon_on_focus" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/save"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/lo_button_height"
                            android:layout_weight="1"
                            android:background="@drawable/lo_button_primary"
                            android:contentDescription="@string/login_connect"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/save_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:duplicateParentState="true"
                                android:fontFamily="@font/launchos_semibold"
                                android:text="@string/login_connect"
                                android:textColor="@color/lo_text_on_accent"
                                android:textSize="@dimen/lo_text_body" />

                            <ProgressBar
                                android:id="@+id/save_spinner"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="@color/lo_on_accent"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/remove"
                            style="@style/Button"
                            android:layout_marginStart="12dp"
                            android:drawableStart="@drawable/ic_trash"
                            android:text="@string/remove" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/result_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/header_tile_bg"
                        android:orientation="horizontal"
                        android:padding="@dimen/lo_space_4"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/result_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/result"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.3"
                            android:textSize="@dimen/lo_text_small" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
