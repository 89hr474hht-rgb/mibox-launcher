<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="@dimen/screen_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/screen_top"
        android:paddingBottom="40dp">

        <include layout="@layout/view_header" />

        <TextView
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingStart="4dp"
            android:text="@string/account_section" />

        <EditText
            android:id="@+id/server"
            android:drawableStart="@drawable/ic_server"
            android:drawablePadding="14dp"
            android:drawableTint="@color/field_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:hint="@string/field_server"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/user"
            android:drawableStart="@drawable/ic_account"
            android:drawablePadding="14dp"
            android:drawableTint="@color/field_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="username"
            android:hint="@string/field_user"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <EditText
            android:id="@+id/password"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="14dp"
            android:drawableTint="@color/field_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/field_password"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/save"
                style="@style/Button"
                android:drawableStart="@drawable/ic_check"
                android:layout_width="wrap_content"
                android:text="@string/save_test" />

            <TextView
                android:id="@+id/remove"
                style="@style/Button"
                android:drawableStart="@drawable/ic_trash"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/remove" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/result_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/panel_bg"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/result_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.35"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
