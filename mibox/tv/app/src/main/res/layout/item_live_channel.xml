<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/live_row_bg"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/num"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:fontFamily="@font/launchos_medium"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/row_sub"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/logo_bg">

        <TextView
            android:id="@+id/initials"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#66FFFFFF"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:fontFamily="@font/launchos_semibold"
                android:singleLine="true"
                android:textColor="@color/row_text"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/star"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star"
                android:tint="@color/row_sub"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tag"
                style="@style/Tag"
                android:layout_marginStart="6dp"
                android:duplicateParentState="true"
                android:textColor="@color/row_sub"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/row_sub"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/track"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/track_bg"
            android:visibility="invisible">

            <View
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bar_fill" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/playing"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/playing_dot"
        android:visibility="gone" />
</LinearLayout>
