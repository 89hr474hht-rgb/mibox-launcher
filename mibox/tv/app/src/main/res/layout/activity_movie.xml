<?xml version="1.0" encoding="utf-8"?>
<!--
  A film, laid out like a series (activity_series): its poster blurred behind the page; what the film is on the left
  (label, title, year, length, genre, summary, people), and on the right a panel with the poster and the actions
  (Regarder or Reprendre, Depuis le début, Bande-annonce). Nothing that acts sits at the bottom right.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lo_black">

    <ImageView
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="@dimen/lo_page_x">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lo_space_2"
                android:ellipsize="end"
                android:fontFamily="@font/launchos_bold"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="2"
                android:textSize="@dimen/lo_text_display" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lo_space_2"
                android:fontFamily="@font/launchos_medium"
                android:singleLine="true"
                android:textColor="@color/lo_text"
                android:textSize="@dimen/lo_text_small" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lo_space_3"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="7"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_body" />

            <com.gathin.launchos.tv.SkeletonView
                android:id="@+id/plot_skeleton"
                android:layout_width="420dp"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.25"
                android:maxLines="3"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_small" />
        </LinearLayout>

        <Space
            android:layout_width="44dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:background="@drawable/lo_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/lo_space_5">

            <FrameLayout
                android:id="@+id/poster_frame"
                android:layout_width="140dp"
                android:layout_height="210dp"
                android:background="@drawable/clip_round">

                <com.gathin.launchos.tv.SkeletonView
                    android:id="@+id/poster_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/play"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/lo_space_5"
                android:drawableStart="@drawable/ic_play"
                android:text="@string/detail_play" />

            <TextView
                android:id="@+id/restart"
                style="@style/Button"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/lo_space_2"
                android:drawableStart="@drawable/ic_restart"
                android:text="@string/detail_restart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/trailer"
                style="@style/Button"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/lo_space_2"
                android:drawableStart="@drawable/ic_movie"
                android:text="@string/detail_trailer"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
