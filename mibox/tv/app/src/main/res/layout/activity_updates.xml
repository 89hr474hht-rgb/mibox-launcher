<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upd_title"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/installed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/install"
                style="@style/Button"
                android:layout_width="wrap_content"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/check"
                style="@style/Button"
                android:layout_width="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/upd_check" />

            <TextView
                android:id="@+id/later"
                style="@style/Button"
                android:layout_width="wrap_content"
                android:text="@string/upd_later"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permission_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/clip_round"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upd_err_permission"
                android:textColor="@color/danger"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/permission_open"
                style="@style/Button"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upd_permission_open" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_title"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/upd_history"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
