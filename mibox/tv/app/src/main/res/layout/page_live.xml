<?xml version="1.0" encoding="utf-8"?>
<!-- Chaînes: the groups (Favoris first), the group's channels, and on the right what is on now and next on the
     focused channel, with the small player (or the channel's logo) in the bottom-right corner, inside the page
     frame (lo_page_x, lo_page_y). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lo_black"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="@dimen/topbar_height">

    <LinearLayout
        android:id="@+id/groups_column"
        android:layout_width="236dp"
        android:layout_height="match_parent"
        android:background="@drawable/column_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="@dimen/lo_page_y"
        android:paddingEnd="12dp">

        <!-- TV's two views: what is on now (this page) and the guide (its own screen). -->
        <LinearLayout
            android:id="@+id/tv_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lo_space_2"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tab_live"
                style="@style/Chip"
                android:text="@string/tv_tab_live" />

            <TextView
                android:id="@+id/tab_guide"
                style="@style/Chip"
                android:layout_marginStart="@dimen/lo_space_2"
                android:drawableStart="@drawable/ic_guide"
                android:text="@string/tv_tab_guide" />
        </LinearLayout>

        <TextView
            android:id="@+id/groups_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:textColor="@color/lo_text_3"
            android:textSize="@dimen/lo_text_small" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groups"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:text="@string/group_options_hint"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channels_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="@dimen/lo_page_y"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/group_title"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:textSize="@dimen/lo_text_heading" />

        <TextView
            android:id="@+id/group_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_small" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/channels_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/lo_text_2"
                    android:textSize="@dimen/lo_text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/retry"
                    style="@style/Button"
                    android:layout_marginTop="@dimen/lo_space_4"
                    android:drawableStart="@drawable/ic_refresh"
                    android:text="@string/retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_column"
        android:layout_width="370dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/lo_space_4"
        android:paddingTop="@dimen/lo_page_y"
        android:paddingEnd="@dimen/lo_page_x">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_name"
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/lo_text_heading" />

            <TextView
                android:id="@+id/detail_tag"
                style="@style/Tag"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_watched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_small" />

        <LinearLayout
            android:id="@+id/detail_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_now_label"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_now" />

            <TextView
                android:id="@+id/detail_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/launchos_semibold"
                android:maxLines="2"
                android:textSize="@dimen/lo_text_body" />

            <TextView
                android:id="@+id/detail_now_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_small" />

            <FrameLayout
                android:id="@+id/detail_track"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/lo_track">

                <View
                    android:id="@+id/detail_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/detail_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_body" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/live_next"
                android:textColor="@color/lo_text_2" />

            <TextView
                android:id="@+id/detail_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/lo_text_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_no_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/live_no_guide"
            android:textColor="@color/lo_text_2"
            android:textSize="@dimen/lo_text_small"
            android:visibility="gone"
            tools:ignore="SelectableText" />

        <!-- The small player sits in the bottom-right corner, inside the page frame (the mini-player's place). -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/pip_slot"
            android:layout_width="@dimen/pip_width"
            android:layout_height="@dimen/pip_height"
            android:layout_marginBottom="@dimen/lo_page_y"
            android:background="@drawable/pip_slot_bg">

            <ImageView
                android:id="@+id/slot_logo"
                android:layout_width="150dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/slot_initials"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/lo_text_3"
                android:textSize="@dimen/lo_text_display" />

            <TextView
                android:id="@+id/slot_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:text="@string/live_ok_hint"
                android:textColor="@color/lo_text_2"
                android:textSize="@dimen/lo_text_small" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
