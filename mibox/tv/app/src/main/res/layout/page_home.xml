<?xml version="1.0" encoding="utf-8"?>
<!--
  Accueil: the hero in the top third (what is being watched, or the newest, over its picture full screen fading
  to black at the bottom), then the shelves: Reprendre la lecture, your channels, the newest films and series.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/backdrop_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/backdrop_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ds_home_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:layout_marginStart="@dimen/page_start"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_label"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/home_title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/launchos_bold"
                android:singleLine="true"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/home_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/launchos_medium"
                android:singleLine="true"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="#BFFFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/home_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_play"
                    style="@style/DsButtonPrimary"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/hero_play" />

                <TextView
                    android:id="@+id/home_info"
                    style="@style/DsButton"
                    android:layout_marginStart="12dp"
                    android:drawableStart="@drawable/ic_info"
                    android:text="@string/hero_info" />
            </LinearLayout>
        </LinearLayout>

        <!-- Clips the shelves to their area, so a shelf scrolled up never draws over the hero. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/home_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_start">

                <com.gathin.launchos.tv.SkeletonView
                    android:layout_width="180dp"
                    android:layout_height="16dp" />

                <LinearLayout
                    android:id="@+id/home_skeleton_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:paddingStart="140dp"
                android:paddingEnd="60dp"
                android:textColor="@color/ds_text_dim"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
