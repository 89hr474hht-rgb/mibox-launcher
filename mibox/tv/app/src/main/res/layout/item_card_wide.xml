<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/wide_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wide_height"
        android:background="@drawable/poster_bg"
        android:duplicateParentState="true"
        android:padding="3dp">

        <FrameLayout
            android:id="@+id/clip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/clip_round">

            <TextView
                android:id="@+id/initials"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="4"
                android:padding="10dp"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/badge"
                style="@style/Tag"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/badge_dark"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/track"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:layout_margin="8dp"
                android:background="@drawable/resume_track"
                android:visibility="gone">

                <View
                    android:id="@+id/bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar_fill" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/launchos_medium"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:singleLine="true"
        android:textColor="@color/card_title"
        android:textSize="12sp" />
</LinearLayout>
