<?xml version="1.0" encoding="utf-8"?>
<!--
  LaunchOS TV's theme and widget styles, on the shared design system (mibox/design): lo_* colours, radii and type
  sizes. The font (Inter) is set here, since the shared Lo.Text styles carry sizes and colours only.
  Two button looks: Button (secondary, dark pill) and Button.Primary (the accent); Chip for filters and groups;
  OsdButton for the player's round controls. Focus is the same everywhere: white fill, dark text and icon.
-->
<resources>
    <style name="Theme.LaunchOSTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lo_black</item>
        <item name="android:colorAccent">@color/lo_accent</item>
        <item name="android:colorBackground">@color/lo_black</item>
        <item name="android:textColorPrimary">@color/lo_text</item>
        <item name="android:textColorSecondary">@color/lo_text_2</item>
        <item name="android:textViewStyle">@style/Text</item>
        <item name="android:editTextStyle">@style/Field</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Theme.LaunchOSTV.Player">
        <item name="android:windowBackground">@color/lo_black</item>
    </style>

    <style name="Text" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/launchos_regular</item>
        <item name="android:textColor">@color/lo_text</item>
    </style>

    <style name="Title">
        <item name="android:fontFamily">@font/launchos_semibold</item>
        <item name="android:textColor">@color/lo_text</item>
    </style>

    <!-- The one text field: the second surface, outlined in white while focused. -->
    <style name="Field" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/launchos_regular</item>
        <item name="android:textColor">@color/lo_text</item>
        <item name="android:textColorHint">@color/lo_text_3</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
        <item name="android:background">@drawable/lo_field</item>
        <item name="android:paddingStart">@dimen/lo_space_4</item>
        <item name="android:paddingEnd">@dimen/lo_space_4</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">@dimen/lo_space_3</item>
        <item name="android:drawableTint">@color/field_icon</item>
    </style>

    <!-- A secondary action: a dark pill, white when focused. -->
    <style name="Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/lo_button_height</item>
        <item name="android:background">@drawable/lo_focus_button</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/lo_space_5</item>
        <item name="android:paddingEnd">@dimen/lo_space_5</item>
        <item name="android:drawablePadding">@dimen/lo_space_2</item>
        <item name="android:drawableTint">@color/lo_icon_on_focus</item>
        <item name="android:fontFamily">@font/launchos_semibold</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
        <item name="android:textColor">@color/lo_text_on_focus</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- The page's main action: the accent, white when focused. -->
    <style name="Button.Primary">
        <item name="android:background">@drawable/lo_button_primary</item>
        <item name="android:textColor">@color/lo_text_on_accent</item>
        <item name="android:drawableTint">@color/lo_text_on_accent</item>
    </style>

    <!-- A filter, an order or a group to pick: a smaller pill; the one in use is faintly filled (selected). -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/lo_focus_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/lo_space_4</item>
        <item name="android:paddingEnd">@dimen/lo_space_4</item>
        <item name="android:drawablePadding">@dimen/lo_space_2</item>
        <item name="android:drawableTint">@color/lo_icon_on_focus</item>
        <item name="android:fontFamily">@font/launchos_medium</item>
        <item name="android:textSize">@dimen/lo_text_small</item>
        <item name="android:textColor">@color/lo_text_on_focus</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- A round control of the player's display. -->
    <style name="OsdButton">
        <item name="android:layout_width">@dimen/lo_button_height</item>
        <item name="android:layout_height">@dimen/lo_button_height</item>
        <item name="android:background">@drawable/lo_focus_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">13dp</item>
        <item name="android:tint">@color/lo_icon_on_focus</item>
    </style>

    <!-- A section in the top bar: its name, white when focused, in the accent while it is shown. -->
    <style name="NavTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">@dimen/lo_space_1</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/lo_space_4</item>
        <item name="android:paddingEnd">@dimen/lo_space_4</item>
        <item name="android:fontFamily">@font/launchos_medium</item>
        <item name="android:textSize">@dimen/lo_text_body</item>
        <item name="android:textColor">@color/lo_text_on_focus</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- An icon in the top bar (Réglages, Rechercher): round, white when focused. -->
    <style name="NavIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">@dimen/lo_space_1</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- A tiny badge (quality, Épinglé): the only text allowed at the label size. -->
    <style name="Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/tag_bg</item>
        <item name="android:fontFamily">@font/launchos_semibold</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/lo_text_2</item>
        <item name="android:textSize">@dimen/lo_text_label</item>
    </style>

    <!-- A short label above a title or a group of rows. -->
    <style name="Label">
        <item name="android:fontFamily">@font/launchos_semibold</item>
        <item name="android:textColor">@color/lo_text_2</item>
        <item name="android:textSize">@dimen/lo_text_label</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
