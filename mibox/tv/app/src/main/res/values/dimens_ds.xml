<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The mini-player (picture-in-picture) sits in the bottom-right corner, inside the page frame (lo_page_x from the
      right, lo_page_y from the bottom). Nothing that matters may sit there or within 24 dp of it: the dead zone is
      pip_width + 48 + 24 by pip_height + 27 + 24 (306 + 48 + 24, 172 + 27 + 24). SafeScrollView keeps focused rows out
      of it.
    -->
    <dimen name="pip_zone_width">378dp</dimen>
    <dimen name="pip_zone_height">223dp</dimen>
    <!-- Guide TV: the channel column and one channel's line. -->
    <dimen name="guide_channel_width">220dp</dimen>
    <dimen name="guide_row_height">60dp</dimen>
</resources>
