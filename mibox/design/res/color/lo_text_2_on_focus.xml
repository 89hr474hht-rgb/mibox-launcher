<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary text on a focusable row: dark grey on the white focus, else the secondary white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#B30E0F11" android:state_focused="true" />
    <item android:color="@color/lo_text_3" android:state_enabled="false" />
    <item android:color="@color/lo_text_2" />
</selector>
