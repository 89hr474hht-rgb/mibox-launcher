<?xml version="1.0" encoding="utf-8"?>
<!-- A value in the accent: dark on the white focus, the accent otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/lo_on_focus" android:state_focused="true" />
    <item android:color="@color/lo_on_focus" android:state_pressed="true" />
    <item android:color="@color/lo_accent" />
</selector>
