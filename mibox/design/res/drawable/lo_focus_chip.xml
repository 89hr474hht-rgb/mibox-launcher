<?xml version="1.0" encoding="utf-8"?>
<!-- A chip or round icon button: outlined, white when focused, filled faintly while chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape><solid android:color="@color/lo_focus" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/lo_surface_3" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/lo_surface_3" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/lo_surface_2" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
</selector>
