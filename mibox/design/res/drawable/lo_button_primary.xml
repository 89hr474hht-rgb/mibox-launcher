<?xml version="1.0" encoding="utf-8"?>
<!-- The primary button: the app's accent, flat; white when focused, like every focused thing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape><solid android:color="@color/lo_focus" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape><solid android:color="@color/lo_surface_2" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/lo_accent" /><corners android:radius="@dimen/lo_radius_pill" /></shape>
    </item>
</selector>
